{
  "name": "StoiCom - Pipeline Automatizado de Distribución (Videos & Reddit)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1,3,5"
            }
          ]
        }
      },
      "id": "b1000000-0000-0000-0000-000000000001",
      "name": "Programador Semanal (Lun, Mié, Vie 9AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\n// Rotación automática entre los días del programa (1 a 90)\nconst dayNumber = (Math.floor(now.getTime() / (1000 * 60 * 60 * 24)) % 90) + 1;\nreturn [\n  {\n    json: {\n      day: dayNumber,\n      timestamp: now.toISOString(),\n      trigger_source: 'n8n_scheduler'\n    }\n  }\n];"
      },
      "id": "b1000000-0000-0000-0000-000000000002",
      "name": "Calcular Día de StoiCom",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/run-pipeline",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"day\": {{ $json.day }},\n  \"mode\": \"all\",\n  \"use_veo\": true\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "b1000000-0000-0000-0000-000000000003",
      "name": "Ejecutar Pipeline Audiovisual en PC Local (GPU NVENC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b1000000-0000-0000-0000-000000000004",
      "name": "¿Pipeline Exitoso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "message": "=🚀 **StoiCom Distribución Completada (Día {{ $('Calcular Día de StoiCom').item.json.day }})**\n\n🎬 **Video 9:16:** Listo para Shorts / TikTok\n📄 **Reddit Post:** {{ $json.reddit_file }}\n⏱️ **Procesado con:** GPU RTX 2050 + Google Veo/Edge-TTS"
      },
      "id": "b1000000-0000-0000-0000-000000000005",
      "name": "Notificación de Éxito",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, -60]
    }
  ],
  "connections": {
    "Programador Semanal (Lun, Mié, Vie 9AM)": {
      "main": [
        [
          {
            "node": "Calcular Día de StoiCom",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calcular Día de StoiCom": {
      "main": [
        [
          {
            "node": "Ejecutar Pipeline Audiovisual en PC Local (GPU NVENC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar Pipeline Audiovisual en PC Local (GPU NVENC)": {
      "main": [
        [
          {
            "node": "¿Pipeline Exitoso?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Pipeline Exitoso?": {
      "main": [
        [
          {
            "node": "Notificación de Éxito",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
